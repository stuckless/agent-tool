{
  "name": "agent-tool",
  "version": "0.1.0",
  "private": true,
  "description": "A small, transparent agent runtime for Node.js.",
  "type": "module",
  "bin": {
    "agent-tool": "dist/cli.js",
    "agent-eval": "dist/eval-cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:eval": "tsx src/eval-cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mcp-stdio": "vitest run test/mcp-stdio.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.41",
    "@ai-sdk/provider": "^4.0.9",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yargs": "^18.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
